      ]
    },
    {
      "name": "SwiftLint + SwiftFormat ausführen",
      "commands": [
        "swiftlint --config /Users/Christian.Drapatz/GITHOME/bitone-ios-wla/.swiftlint.yml /Users/Christian.Drapatz/GITHOME/bitone-ios-wla",
