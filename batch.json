        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla clean -fd"
      ]
    },
    {
      "name": "Lokale Änderungen verwerfen",
      "commands": [
        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla reset --hard HEAD",
        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla clean -fd"
      ]
    },
    {
      "name": "Auf develop zurücksetzen",
      "commands": [
        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla fetch origin",
        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla checkout develop",
        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla reset --hard origin/develop",
        "git -C /Users/Christian.Drapatz/GITHOME/bitone-ios-wla clean -fd"
      ]
    },
    {
      "separator": true
    },
    {
      "name": ".DS_Store-Dateien löschen",
      "commands": [
